{
  "schemaVersion": 1,
  "id": "curio-observer",
  "version": "${version}",
  "name": "Curio Observer",
  "description": "Client-only spectator HUD with adaptive camera and dark-area brightening. No feed, dashboard or server mod required.",
  "environment": "client",
  "entrypoints": { "client": ["dev.curio.observer.CurioObserverClient"] },
  "mixins": ["curio-observer.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.5",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
